 .research-grid details { background: #fff; border: 1px solid #dfd6ef; border-radius: 9px; }
 .research-grid summary { display: flex; min-height: 50px; align-items: center; gap: 9px; padding: 10px 12px; font-weight: 800; cursor: pointer; }
 .research-grid summary span { color: var(--purple); font-family: var(--ui-font-mono); font-size: 11px; }
 .research-grid p { margin: 0; padding: 0 13px 13px 42px; color: var(--muted); font-size: 14px; }
 .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 28px max(22px, calc((100vw - 1240px) / 2)); background: var(--navy); color: #fff; }
 .site-footer div { display: grid; }
 .site-footer span { color: #b9c8d7; font-size: 13px; }
 .site-footer a { color: #8ce0b6; font-weight: 800; }
 .site-footer .site-footer__actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
 .site-footer .chapter-unlock-reset { border-color: rgba(255,255,255,.35); color: #dce6ef; }
