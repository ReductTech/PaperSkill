+.paper-crop { position: relative; aspect-ratio: var(--paper-crop-aspect, 16 / 9); overflow: hidden; background: #f5f4f1; border: 1px solid var(--line); border-radius: 12px; }
+.paper-crop > img { position: absolute; width: var(--paper-crop-image-width, 100%); height: auto; max-width: none; left: var(--paper-crop-image-left, 0); top: var(--paper-crop-image-top, 0); }
