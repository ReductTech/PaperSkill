+.viewer-trigger:focus-visible, .paper-media__source:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
+.paper-media__fallback { position: absolute; inset: 0; display: grid; place-content: center; gap: 8px; padding: 20px; color: var(--muted); text-align: center; }
+.paper-media__fallback strong { color: var(--navy); }
+.paper-media figcaption { color: var(--muted); line-height: 1.5; }
+.paper-media__source { min-height: 44px; display: inline-flex; align-items: center; color: var(--blue); font-weight: 800; }
+@media (prefers-reduced-motion: reduce) { .paper-crop *, .viewer-trigger { animation: none !important; transition: none !important; } }

