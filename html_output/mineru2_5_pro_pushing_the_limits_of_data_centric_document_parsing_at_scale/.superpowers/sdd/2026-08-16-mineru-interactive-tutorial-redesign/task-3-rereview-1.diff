+.data-counterfactual__comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
+.counterfactual-lane { display: grid; gap: 10px; padding: 13px; border: 1px solid var(--line, #d7deea); border-radius: 16px; background: #fff; transition: border-color .2s ease, transform .2s ease; }
+.counterfactual-lane[data-active="true"] { border: 2px solid var(--green, #228d5c); transform: translateY(-2px); }
+.counterfactual-lane > div { display: grid; gap: 3px; }.counterfactual-lane span { color: var(--muted, #68778f); font-size: 13px; }
+.data-counterfactual__gaps { display: flex; flex-wrap: wrap; gap: 8px; }.data-counterfactual__gaps span { padding: 8px 10px; border: 1px dashed var(--line, #d7deea); border-radius: 999px; color: var(--muted, #68778f); font-size: 13px; font-weight: 800; }.data-counterfactual__gaps span[data-covered="true"] { border-style: solid; border-color: var(--green, #228d5c); background: #edf8f2; color: var(--green, #228d5c); }
+.data-counterfactual__actions, .ddas-microscope__controls, .ddas-microscope__mobile-controls { display: flex; flex-wrap: wrap; gap: 10px; }.data-counterfactual button, .ddas-microscope button { min-height: 44px; padding: 9px 14px; border: 1px solid var(--blue, #27446e); border-radius: 10px; background: #fff; color: var(--blue, #27446e); cursor: pointer; font: inherit; font-weight: 800; }.data-counterfactual button[aria-pressed="true"], .ddas-microscope button:hover { background: var(--blue-soft, #eef3f8); }
+.data-counterfactual__hint, .ddas-microscope__state { margin: 0; color: var(--muted, #68778f); font-size: 13px; }.data-counterfactual__result { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: center; padding: 14px; border-left: 4px solid var(--green, #228d5c); background: #edf8f2; }.data-counterfactual__result output { color: var(--green, #228d5c); font-size: 1.75rem; font-weight: 900; }.data-counterfactual__result p, .experience-boundary { margin: 0; color: var(--muted, #68778f); font-size: 12px; line-height: 1.55; }
+.ddas-microscope__header p { display: grid; gap: 4px; margin: 0; color: var(--blue, #27446e); font-size: 13px; text-align: right; }.ddas-microscope__header p span { color: var(--muted, #68778f); }
+.ddas-microscope__canvas { position: relative; overflow: hidden; min-height: 290px; border: 2px solid var(--line, #d7deea); border-radius: 18px; background: #f5f8f0; outline: none; }.ddas-microscope__canvas:focus-visible { outline: 3px solid var(--blue, #27446e); outline-offset: 3px; }.ddas-microscope__canvas .paper-media { padding: 14px; }.ddas-microscope__canvas .paper-media figcaption, .ddas-microscope__canvas .paper-media__source { display: none; }
+.ddas-microscope__clusters { position: absolute; inset: auto 16px 16px; display: flex; justify-content: center; gap: 8px; pointer-events: none; }.ddas-microscope__thumbnail { width: min(25%, 160px); }.ddas-microscope__thumbnail .paper-media__label, .ddas-microscope__thumbnail figcaption, .ddas-microscope__thumbnail .paper-media__source, .ddas-microscope__thumbnail .viewer-trigger { display: none; }.ddas-microscope__thumbnail .paper-crop { height: 74px; aspect-ratio: auto; border: 2px solid #fff; box-shadow: 0 4px 12px rgba(19, 42, 69, .2); }.ddas-microscope__lens { position: absolute; width: 64px; height: 64px; border: 3px solid var(--orange, #d97706); border-radius: 50%; box-shadow: 0 0 0 999px rgba(255,255,255,.14), 0 0 0 4px rgba(255,255,255,.7); pointer-events: none; transform: translate(-50%, -50%); transition: left .12s ease, top .12s ease; }.ddas-microscope__element-overlay { position: absolute; right: 18px; bottom: 18px; padding: 9px 11px; border-radius: 9px; background: rgba(21, 38, 60, .9); color: #fff; font-size: 13px; font-weight: 800; }
+@media (prefers-reduced-motion: reduce) { .counterfactual-lane, .ddas-microscope__lens { transition: none; } }
