{
  "name": "paper-tutorial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "node --test tests/math.test.mjs tests/lifecycle.test.mjs tests/reservoir.test.mjs tests/training.test.mjs tests/evidence.test.mjs tests/augmentation.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:playback": "node tests/lifecycle-playback.mjs && node tests/playback.test.mjs",
    "test:workbench-layout": "node tests/workbench-layout.test.mjs",
    "test:lesson-playback": "node tests/lesson-playback.test.mjs",
    "test:augmentation": "node tests/browser.test.mjs --augmentation-only",
    "test:connectors": "node tests/browser.test.mjs --connectors-only"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
