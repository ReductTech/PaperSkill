{
  "baseUrl": "http://127.0.0.1:4174",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "runner",
      "--host",
      "127.0.0.1",
      "--port",
      "4174",
      "--strictPort"
    ],
    "cwd": ".",
    "readyPath": "/"
  },
  "pages": [
    {
      "id": "p1",
      "path": "/?page=p1",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "snapshot2",
          "actions": [
            {
              "type": "click",
              "selector": ".task-rail button:nth-child(2)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p2",
      "path": "/?page=p2",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "patch196",
          "actions": [
            {
              "type": "press",
              "selector": "#patch-index",
              "key": "End"
            },
            {
              "type": "click",
              "selector": ".patch-motion .motion-stops button:nth-child(4)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p3",
      "path": "/?page=p3",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "extra",
          "actions": [
            {
              "type": "click",
              "selector": ".attention-controls input"
            }
          ]
        },
        {
          "id": "head-output",
          "actions": [
            {
              "type": "click",
              "selector": ".head-animation .motion-stops button:nth-child(4)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p4",
      "path": "/?page=p4",
      "states": [
        { "id": "initial" },
        { "id": "forward", "actions": [{ "type": "click", "selector": ".p4-phase-list button:nth-child(2)" }] },
        { "id": "loss", "actions": [{ "type": "click", "selector": ".p4-phase-list button:nth-child(3)" }] },
        { "id": "backward", "actions": [{ "type": "click", "selector": ".p4-phase-list button:nth-child(4)" }] },
        { "id": "write-intermediate", "actions": [{ "type": "click", "selector": ".p4-phase-list button:nth-child(5)" }] },
        { "id": "rerun", "actions": [{ "type": "click", "selector": ".p4-phase-list button:nth-child(6)" }] },
        { "id": "shared-prompt", "actions": [{ "type": "scrollIntoView", "selector": ".p4-shared-prompt .viewport-drawing" }, { "type": "waitFor", "selector": ".p4-shared-prompt[data-guide-phase='2']", "timeoutMs": 5000 }, { "type": "wait", "milliseconds": 1500 }] }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" },
        { "selector": ".p4-training-figure", "property": "overflow", "equals": "visible" },
        { "selector": ".p4-node h4", "property": "font-size", "equals": "16px" }
      ]
    },
    {
      "id": "p5-retrieval",
      "path": "/?page=p5",
      "states": [
        { "id": "pair", "actions": [{ "type": "scrollIntoView", "selector": ".p5-slot-anatomy" }] },
        { "id": "angle-a", "actions": [{ "type": "click", "selector": ".p5-scan-keys button:nth-child(1)" }] },
        { "id": "scanning", "actions": [{ "type": "fill", "selector": ".p5-compare-figure input[type=range]", "value": "1110" }] },
        { "id": "sorting", "actions": [{ "type": "fill", "selector": ".p5-retrieval-figure input[type=range]", "value": "1340" }] },
        { "id": "ranked", "actions": [{ "type": "fill", "selector": ".p5-retrieval-figure input[type=range]", "value": "4400" }] },
        { "id": "copying", "actions": [{ "type": "fill", "selector": ".p5-retrieval-figure input[type=range]", "value": "5310" }] },
        { "id": "read-a", "actions": [{ "type": "fill", "selector": ".p5-retrieval-figure input[type=range]", "value": "8800" }] },
        { "id": "angle-b", "actions": [
          { "type": "click", "selector": ".p5-query-controls button:has-text('查询 B')" },
          { "type": "click", "selector": ".p5-scan-keys button:nth-child(4)" }
        ] },
        { "id": "read-b", "actions": [
          { "type": "click", "selector": ".p5-query-controls button:has-text('查询 B')" },
          { "type": "fill", "selector": ".p5-retrieval-figure input[type=range]", "value": "8800" }
        ] },
        { "id": "overlap", "actions": [{ "type": "scrollIntoView", "selector": ".p5-overlap .viewport-drawing" }, { "type": "waitFor", "selector": ".p5-overlap[data-guide-phase='2']", "timeoutMs": 5000 }, { "type": "wait", "milliseconds": 650 }] }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" },
        { "selector": ".p5-retrieval-figure", "property": "overflow", "equals": "visible" },
        { "selector": ".p5-slot-pair-link", "property": "font-size", "equals": "14px" }
      ]
    },
    {
      "id": "p6",
      "path": "/?page=p6",
      "states": [
        {"id":"source","actions":[]},
        {"id":"assembly-midpoint","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":1900}]},
        {"id":"assembled","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":3060}]},
        {"id":"encoder-midpoint","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":4300}]},
        {"id":"pooling-midpoint","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":7700}]},
        {"id":"pooled","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":9700}]},
        {"id":"classifier-midpoint","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":11100}]},
        {"id":"class-logits","actions":[{"type":"fill","selector":".p6-control-dock input[type='range']","value":13600}]},
        {"id":"pooling-trace","actions":[{"type":"scrollIntoView","selector":".p6-pooling-trace .viewport-drawing"},{"type":"waitFor","selector":".p6-pooling-trace[data-guide-phase='2']","timeoutMs":5000},{"type":"wait","milliseconds":1500}]}
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p7",
      "path": "/?page=p7",
      "states": [
        {"id":"snapshot","actions":[]},
        {"id":"classification-midpoint","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":2020}]},
        {"id":"matching-midpoint","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":4650}]},
        {"id":"batch-b-midpoint","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":7740}]},
        {"id":"shared-slot-3","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":10300},{"type":"click","selector":".p7-slots [data-slot='3']"}]},
        {"id":"untouched-slot-7","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":14300},{"type":"click","selector":".p7-slots [data-slot='7']"}]},
        {"id":"merge-midpoint","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":11500}]},
        {"id":"writeback-midpoint","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":12900}]},
        {"id":"one-writeback","actions":[{"type":"fill","selector":".p7-control-dock input[type='range']","value":14300}]},
        {"id":"key-lab-collect","actions":[{"type":"fill","selector":".p7-key-lab input[type='range']","value":2060}]},
        {"id":"key-lab-write","actions":[{"type":"fill","selector":".p7-key-lab input[type='range']","value":5000}]},
        {"id":"key-lab-final","actions":[{"type":"fill","selector":".p7-key-lab input[type='range']","value":8100}]},
        {"id":"optimizer-settings","actions":[{"type":"scrollIntoView","selector":".p7-optimizer-note"},{"type":"click","selector":".p7-optimizer-note > summary"}]}
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
        ,{ "selector": ".p7-optimizer-note > summary", "property": "font-size", "equals": "14px" }
        ,{ "selector": ".p7-optimizer-note > p", "property": "font-size", "equals": "15px" }
      ]
    },
    {
      "id": "p8",
      "path": "/?page=p8",
      "states": [
        {"id":"initialization","actions":[]},
        {"id":"task1-query-midpoint","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":3150}]},
        {"id":"batch1-return","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":5410}]},
        {"id":"batch1-write-midpoint","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":6260}]},
        {"id":"batch2-reads-version1","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":9620}]},
        {"id":"cross-task-version2","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":13400}]},
        {"id":"task2-reuses-pool","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":17100},{"type":"click","selector":".p8-pool-slots [data-slot='3']"}]},
        {"id":"inference-midpoint","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":21400}]},
        {"id":"inference-version3","actions":[{"type":"fill","selector":".p8-control-dock input[type='range']","value":23900}]}
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p9",
      "path": "/?page=p9",
      "states": [
        { "id": "base-query-a" },
        {
          "id": "distance-sweep",
          "actions": [
            { "type": "click", "selector": ".p9-phase-stops button:nth-child(2)" },
            { "type": "click", "selector": ".p9-playback-status button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 2700 },
            { "type": "click", "selector": ".p9-playback-status button:has-text('暂停')" }
          ]
        },
        {
          "id": "frequency-weight-midpoint",
          "actions": [
            { "type": "click", "selector": ".p9-mode-toggle button:has-text('已知边界训练')" },
            { "type": "click", "selector": ".p9-phase-stops button:nth-child(3)" },
            { "type": "click", "selector": ".p9-playback-status button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 1650 },
            { "type": "click", "selector": ".p9-playback-status button:has-text('暂停')" }
          ]
        },
        {
          "id": "eq4-training-selection",
          "actions": [
            { "type": "click", "selector": ".p9-mode-toggle button:has-text('已知边界训练')" },
            { "type": "click", "selector": ".p9-phase-stops button:nth-child(5)" }
          ]
        },
        {
          "id": "query-b-recomputed-ranking",
          "actions": [
            { "type": "click", "selector": ".p9-query-toggle button:has-text('Query B')" },
            { "type": "click", "selector": ".p9-mode-toggle button:has-text('已知边界训练')" },
            { "type": "click", "selector": ".p9-phase-stops button:nth-child(5)" }
          ]
        },
        {
          "id": "inference-restores-eq3",
          "actions": [
            { "type": "click", "selector": ".p9-mode-toggle button:has-text('测试 · Eq. (3)')" },
            { "type": "click", "selector": ".p9-phase-stops button:nth-child(5)" }
          ]
        },
        {
          "id": "table5-diversification-ablation",
          "actions": [
            { "type": "scrollIntoView", "selector": ".p9-ablation-list" },
            { "type": "click", "selector": ".p9-ablation-row:nth-child(4)" }
          ]
        },
        { "id": "architecture-upper-bound", "actions": [{ "type": "scrollIntoView", "selector": ".p9-architecture-note" }, { "type": "click", "selector": ".p9-architecture-note > summary" }] }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" },
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p9-control-dock", "property": "position", "equals": "sticky" },
        { "selector": ".lesson-figure.p9-strategy-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p9-candidate-row", "property": "border-bottom-width", "equals": "1px" },
        { "selector": ".p9-architecture-note .p9-results-table", "property": "font-size", "equals": "15px" }
      ]
    }
  ],
  "geometry": {
    "checkPageHorizontalOverflow": true,
    "minSemanticFontSizePx": 12
  }
}
