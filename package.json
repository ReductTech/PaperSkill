{
  "name": "paper-tutorial-collection",
  "private": true,
  "version": "1.0.0",
  "description": "Collaborative collection and publication scaffold for paper-skill tutorials.",
  "scripts": {
    "validate": "node scripts/validate-repository.js",
    "validate:pr": "node scripts/validate-pr-scope.js",
    "catalog": "node scripts/generate-catalog.js",
    "catalog:check": "node scripts/generate-catalog.js --check",
    "import": "node scripts/import-paper.js",
    "migrate:versions": "node scripts/migrate-to-versions.js",
    "build:all": "node scripts/build-all.js",
    "build:paper": "node scripts/build-paper.js",
    "export:paper": "node scripts/export-single-html.js",
    "build:changed": "node scripts/build-changed.js",
    "build:site": "node scripts/build-site.js",
    "check": "npm run validate && npm run catalog:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.3"
  }
}
